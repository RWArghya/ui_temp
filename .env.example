# "false" = call the real backend; anything else / unset = mock data
VITE_USE_MOCK=true
# Base path the axios client uses (keep /api/v1 so the Vite proxy / nginx handle it)
VITE_API_URL=/api/v1
# Where the Vite dev server proxies /api to (the H2S Go backend in Docker)
VITE_PROXY_TARGET=http://localhost:8090
